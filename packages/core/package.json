{
  "name": "@dsh-editor/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": { "types": "./src/index.ts", "default": "./lib/host.js" },
    "./client": { "types": "./src/client.ts", "default": "./lib/client.js" },
    "./diff": "./src/diff.ts",
    "./package.json": "./package.json"
  },
  "files": ["lib/", "src/"],
  "scripts": { "build": "node ../../scripts/build-package.mjs" },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-workspace-files"
      ]
    }
  }
}

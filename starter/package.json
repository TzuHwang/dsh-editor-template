{
  "name": "my-dsh-project",
  "version": "0.1.0",
  "private": true,
  "description": "A DSH editor project built on dsh-editor-template.",
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib/", "cordis.patch.yml"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["@dsh-editor/core"] }
  },
  "dshEditor": {
    "template": "github:TzuHwang/dsh-editor-template",
    "release": "v0.1.0-dist"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "install-command": "node scripts/install-command.mjs"
  },
  "devDependencies": {
    "@dsh-editor/core": "github:TzuHwang/dsh-editor-template#v0.1.0-dist&path:/packages/core",
    "@types/react": "^19.2.18",
    "esbuild": "^0.28.2",
    "react": "^19.2.8",
    "typescript": "^6.0.3"
  }
}
